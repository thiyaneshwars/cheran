# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI Agent Workspaces & Cache
.agent/
.agents/
.claude/
.codex/
.cursor/
.gemini/
.impeccable/
.opencode/

# Database Backups & Temporary DBs (dev.db is tracked for global read-only)
backups/
prisma/*.backup*
prisma/test.db

# Logs & Temp
*.log
