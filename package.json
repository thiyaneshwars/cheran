{
  "name": "cheran-accounting",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "prod:init": "node scripts/init-prod.js",
    "backup": "node scripts/backup-db.js",
    "restore": "node scripts/restore-db.js",
    "tunnel": "cloudflared tunnel --url http://127.0.0.1:3000 --http-host-header localhost:3000",
    "sync-global": "git add prisma/dev.db && git commit -m \"Update accounting snapshot\" && git push",
    "lint": "eslint",
    "test": "vitest run --no-file-parallelism",
    "seed": "tsx prisma/seed-prod.ts",
    "seed:prod": "tsx prisma/seed-prod.ts",
    "seed:demo": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed-prod.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/three": "^0.187.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.53.0",
    "next": "^16.4.3",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.4"
  }
}
